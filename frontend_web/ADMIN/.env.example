# Cấu hình kết nối Backend API
# Khi backend của bạn đã sẵn sàng, hãy trỏ URL tới server backend (ví dụ: http://localhost:5000/api hoặc http://localhost:8080/api)
VITE_API_BASE_URL=http://localhost:5000/api

# Chế độ dữ liệu:
# - true: Sử dụng dữ liệu mẫu (Mock data) tích hợp sẵn để demo và phát triển giao diện
# - false: Gọi trực tiếp Backend API qua Axios
VITE_USE_MOCK=true

